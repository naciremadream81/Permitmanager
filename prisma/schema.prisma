// PermitPro - Prisma Schema
// Permit lifecycle management system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────────

enum PermitStatus {
  DRAFT
  PENDING_REVIEW
  SUBMITTED
  UNDER_REVIEW
  CORRECTIONS_NEEDED
  APPROVED
  ISSUED
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
  CLOSED
}

enum PermitType {
  BUILDING
  ELECTRICAL
  PLUMBING
  MECHANICAL
  DEMOLITION
  GRADING
  FIRE
  SIGN
  ZONING
  ENCROACHMENT
  SPECIAL_USE
  CONDITIONAL_USE
  VARIANCE
  SUBDIVISION
  ENVIRONMENTAL
  OCCUPANCY
  HEALTH
  LIQUOR
  BUSINESS_LICENSE
  OTHER
}

enum DocumentCategory {
  APPLICATION
  PLAN
  ENGINEERING
  SURVEY
  ENVIRONMENTAL
  INSURANCE
  LICENSE
  PERMIT_COPY
  CORRESPONDENCE
  INSPECTION_REPORT
  PHOTO
  RECEIPT
  CONTRACT
  APPROVAL_LETTER
  NOTICE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum ChecklistItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  NOT_APPLICABLE
}

enum InspectionStatus {
  SCHEDULED
  PASSED
  FAILED
  CANCELLED
  RESCHEDULED
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
  REFUNDED
}

enum UserRole {
  OWNER
  ADMIN
  COORDINATOR
  VIEWER
}

enum NotificationType {
  DEADLINE_APPROACHING
  DOCUMENT_EXPIRING
  STATUS_CHANGED
  INSPECTION_REMINDER
  CORRECTION_NEEDED
  TEAM_INVITE
  WEEKLY_DIGEST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── TABLES ─────────────────────────────────────────────────────────────────────

model Organization {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  slug              String   @unique
  logo              String?
  subscriptionTier  String   @default("free") @map("subscription_tier")
  stripeCustomerId  String?  @unique @map("stripe_customer_id")
  settings          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  memberships    OrgMembership[]
  projects       Project[]
  permits        Permit[]
  documents      Document[]
  checklistTemplates ChecklistTemplate[]
  activities     Activity[]
  notifications  Notification[]
  contacts       Contact[]
  subscriptions  Subscription[]
  webhooks       Webhook[]
  tags           Tag[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  avatar    String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships      OrgMembership[]
  assignedPermits  Permit[]         @relation("PermitAssignee")
  uploadedDocuments Document[]      @relation("DocumentUploader")
  assignedChecklist ChecklistItem[] @relation("ChecklistAssignee")
  completedChecklist ChecklistItem[] @relation("ChecklistCompleter")
  comments         Comment[]
  activities       Activity[]
  notifications    Notification[]
  pushTokens       PushToken[]
  aiConversations  AiConversation[]

  @@map("users")
}

model OrgMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  role      UserRole @default(VIEWER)
  invitedAt DateTime @default(now()) @map("invited_at")
  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("org_memberships")
}

model Project {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  name             String
  description      String?
  address          String?
  city             String?
  state            String?
  zip              String?
  latitude         Float?
  longitude        Float?
  startDate        DateTime? @map("start_date")
  estimatedEndDate DateTime? @map("estimated_end_date")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permits      Permit[]

  @@index([orgId])
  @@map("projects")
}

model Permit {
  id                   String       @id @default(uuid()) @db.Uuid
  orgId                String       @map("org_id") @db.Uuid
  projectId            String?      @map("project_id") @db.Uuid
  permitNumber         String?      @map("permit_number")
  type                 PermitType
  status               PermitStatus @default(DRAFT)
  title                String
  description          String?
  jurisdiction         String?
  agency               String?
  appliedDate          DateTime?    @map("applied_date")
  issuedDate           DateTime?    @map("issued_date")
  expirationDate       DateTime?    @map("expiration_date")
  estimatedCost        Float?       @map("estimated_cost")
  actualCost           Float?       @map("actual_cost")
  assigneeId           String?      @map("assignee_id") @db.Uuid
  riskScore            Int?         @map("risk_score")
  completionPercentage Int          @default(0) @map("completion_percentage")
  metadata             Json         @default("{}")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee       User?           @relation("PermitAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  documents      Document[]
  checklistItems ChecklistItem[]
  inspections    Inspection[]
  fees           Fee[]
  comments       Comment[]
  activities     Activity[]
  deadlines      Deadline[]
  aiConversations AiConversation[]
  permitTags     PermitTag[]

  @@index([orgId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([type])
  @@index([orgId, status])
  @@index([orgId, type])
  @@index([expirationDate])
  @@map("permits")
}

model Document {
  id               String           @id @default(uuid()) @db.Uuid
  orgId            String           @map("org_id") @db.Uuid
  permitId         String?          @map("permit_id") @db.Uuid
  name             String
  fileName         String           @map("file_name")
  fileUrl          String           @map("file_url")
  fileSize         Int              @map("file_size")
  mimeType         String           @map("mime_type")
  category         DocumentCategory @default(OTHER)
  status           DocumentStatus   @default(PENDING)
  version          Int              @default(1)
  uploadedById     String           @map("uploaded_by_id") @db.Uuid
  expirationDate   DateTime?        @map("expiration_date")
  extractedData    Json?            @map("extracted_data")
  aiClassification String?          @map("ai_classification")
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permit       Permit?      @relation(fields: [permitId], references: [id], onDelete: SetNull)
  uploadedBy   User         @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([orgId])
  @@index([permitId])
  @@index([uploadedById])
  @@index([category])
  @@index([status])
  @@index([expirationDate])
  @@map("documents")
}

model ChecklistTemplate {
  id           String     @id @default(uuid()) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  name         String
  permitType   PermitType @map("permit_type")
  jurisdiction String?
  items        Json       @default("[]")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([permitType])
  @@map("checklist_templates")
}

model ChecklistItem {
  id            String              @id @default(uuid()) @db.Uuid
  permitId      String              @map("permit_id") @db.Uuid
  title         String
  description   String?
  status        ChecklistItemStatus @default(NOT_STARTED)
  category      String?
  order         Int                 @default(0)
  dueDate       DateTime?           @map("due_date")
  assigneeId    String?             @map("assignee_id") @db.Uuid
  completedAt   DateTime?           @map("completed_at")
  completedById String?             @map("completed_by_id") @db.Uuid
  isConditional Boolean             @default(false) @map("is_conditional")
  condition     Json?
  parentItemId  String?             @map("parent_item_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  permit      Permit         @relation(fields: [permitId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("ChecklistAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy User?          @relation("ChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  parentItem  ChecklistItem? @relation("ChecklistItemChildren", fields: [parentItemId], references: [id], onDelete: SetNull)
  children    ChecklistItem[] @relation("ChecklistItemChildren")

  @@index([permitId])
  @@index([assigneeId])
  @@index([status])
  @@index([permitId, status])
  @@map("checklist_items")
}

model Inspection {
  id             String           @id @default(uuid()) @db.Uuid
  permitId       String           @map("permit_id") @db.Uuid
  type           String
  status         InspectionStatus @default(SCHEDULED)
  scheduledDate  DateTime         @map("scheduled_date")
  completedDate  DateTime?        @map("completed_date")
  inspectorName  String?          @map("inspector_name")
  inspectorPhone String?          @map("inspector_phone")
  location       String?
  notes          String?
  result         String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  permit Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([permitId])
  @@index([status])
  @@index([scheduledDate])
  @@index([permitId, status])
  @@map("inspections")
}

model Fee {
  id          String    @id @default(uuid()) @db.Uuid
  permitId    String    @map("permit_id") @db.Uuid
  description String
  amount      Float
  status      FeeStatus @default(PENDING)
  dueDate     DateTime? @map("due_date")
  paidDate    DateTime? @map("paid_date")
  receiptUrl  String?   @map("receipt_url")
  category    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  permit Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([permitId])
  @@index([status])
  @@index([dueDate])
  @@index([permitId, status])
  @@map("fees")
}

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  permitId        String   @map("permit_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  content         String
  attachments     Json     @default("[]")
  parentCommentId String?  @map("parent_comment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  permit        Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       Comment[] @relation("CommentReplies")

  @@index([permitId])
  @@index([userId])
  @@map("comments")
}

model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  permitId   String?  @map("permit_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permit       Permit?      @relation(fields: [permitId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([permitId])
  @@index([userId])
  @@index([orgId, createdAt])
  @@map("activities")
}

model Notification {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @map("user_id") @db.Uuid
  orgId  String           @map("org_id") @db.Uuid
  type   NotificationType
  title  String
  body   String
  data   Json             @default("{}")
  read   Boolean          @default(false)
  readAt DateTime?        @map("read_at")
  sentAt DateTime         @default(now()) @map("sent_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([userId, read])
  @@index([userId, type])
  @@map("notifications")
}

model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String
  deviceName String?  @map("device_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Deadline {
  id           String    @id @default(uuid()) @db.Uuid
  permitId     String    @map("permit_id") @db.Uuid
  title        String
  dueDate      DateTime  @map("due_date")
  reminderDays Int[]     @default([]) @map("reminder_days")
  status       String    @default("active")
  notifiedAt   DateTime? @map("notified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  permit Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([permitId])
  @@index([dueDate])
  @@index([status])
  @@map("deadlines")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  company   String?
  role      String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("contacts")
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  permitId  String?  @map("permit_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  messages  Json     @default("[]")
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permit Permit? @relation(fields: [permitId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([permitId])
  @@index([userId])
  @@map("ai_conversations")
}

model Subscription {
  id                   String   @id @default(uuid()) @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  plan                 String   @default("free")
  status               String   @default("active")
  currentPeriodEnd     DateTime? @map("current_period_end")
  seats                Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("subscriptions")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  url       String
  events    String[]
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("webhooks")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  color     String   @default("#6B7280")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permitTags   PermitTag[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("tags")
}

model PermitTag {
  id        String   @id @default(uuid()) @db.Uuid
  permitId  String   @map("permit_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  permit Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([permitId, tagId])
  @@index([permitId])
  @@index([tagId])
  @@map("permit_tags")
}
